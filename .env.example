# =============================================================================
# Orders & KDS Frontend — Environment Variables Example
# =============================================================================
# Copy this file to .env.local and fill in the values for your local setup:
#   cp .env.example .env.local
#
# NEVER commit .env.local to version control. Only .env.example (this file,
# without real values) is versioned. A secret scanner (gitleaks) runs on
# every push.
#
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# Variables WITHOUT this prefix are available only in vite.config.ts and
# other Node-side build scripts, never in the final bundle.
#
# For the full description of each variable see docs/CONTRIBUTING_Frontend.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
# Base URL of the Orders & KDS backend, as seen from the browser.
# In local development this goes through the API Gateway on port 8080.
# Do NOT add a trailing slash.
VITE_API_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# WebSocket
# -----------------------------------------------------------------------------
# WebSocket endpoint for real-time order updates (KDS board and ticket widget).
# Must use ws:// in development and wss:// in production.
VITE_WS_URL=ws://localhost:8080/ws

# -----------------------------------------------------------------------------
# Module Federation (build-time — no VITE_ prefix needed)
# -----------------------------------------------------------------------------
# URL from which the Auth Shell will load this remote's remoteEntry.js at runtime.
# In local development: http://localhost:4173 (vite preview after pnpm build).
# In staging/production: the public URL of the deployed Docker container.
# Leave empty to use the Vite default (relative path, suitable for same-origin).
FEDERATION_REMOTE_URL=http://localhost:4173

# -----------------------------------------------------------------------------
# Environment tag
# -----------------------------------------------------------------------------
# Used for logging and error reporting context. Do not expose secrets here.
VITE_APP_ENV=development
