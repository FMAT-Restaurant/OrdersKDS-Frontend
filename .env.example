# =============================================================================
# Orders & KDS Frontend — Environment Variables Example
# =============================================================================
# Copy this file to .env.local and fill in the values for your local setup:
#   cp .env.example .env.local
#
# NEVER commit .env.local to version control. Only .env.example (this file,
# without real values) is versioned. A secret scanner (gitleaks) runs on
# every push.
#
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# Variables WITHOUT this prefix are available only in vite.config.ts and
# other Node-side build scripts, never in the final bundle.
#
# For the full description of each variable see docs/CONTRIBUTING_Frontend.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API (via Kong API Gateway — NEVER put JWT_SECRET in frontend env)
# -----------------------------------------------------------------------------
# Base URL of the Orders & KDS backend through Kong (port 8000).
# Use "auto" (or leave empty) to derive http://<current-host>:8000/api/v1/orders
# (or /api/v1/kitchen when building with --mode cocina).
# Do NOT add a trailing slash.
VITE_API_BASE_URL=auto

# -----------------------------------------------------------------------------
# WebSocket
# -----------------------------------------------------------------------------
# WebSocket gateway base URL for real-time order updates (/ws/kds and /ws/waiter).
# Use "auto" (or leave empty) to derive ws(s):// from VITE_API_BASE_URL / active host.
VITE_WS_URL=auto

# -----------------------------------------------------------------------------
# Module Federation (build-time — no VITE_ prefix needed)
# -----------------------------------------------------------------------------
# URL from which the Auth Shell loads this remote's remoteEntry.js at runtime.
# Local federation defaults: http://localhost:5177 (ordenesApp) / http://localhost:5179 (cocinaApp).
# Leave empty to use the Vite default (relative path, suitable for same-origin).
FEDERATION_REMOTE_URL=http://localhost:5177

# -----------------------------------------------------------------------------
# Environment tag
# -----------------------------------------------------------------------------
# Used for logging and error reporting context. Do not expose secrets here.
VITE_APP_ENV=development

# -----------------------------------------------------------------------------
# Feature Flags (ADR-0011 / OP-12)
# -----------------------------------------------------------------------------
# Platillos intermedios (chef): excluido de la entrega principal.
# Mantener en false en local y CI para no bloquear pruebas ni flujos de trabajo.
VITE_FEATURE_INTERMEDIATE_DISHES=false
INTERMEDIATE_DISHES_ENABLED=false

# -----------------------------------------------------------------------------
# Security / CORS & CSP Overrides (Vite dev & preview — optional)
# -----------------------------------------------------------------------------
# Comma-separated explicit origins allowed by Vite CORS (wildcards '*' fail the build).
# Leave unset to use FMAT defaults (localhost & 127.0.0.1 on 3000, 4173, 5173-5179, 8000).
# VITE_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#
# Additional space/comma-separated origins for CSP connect-src / script-src & style-src:
# VITE_CSP_CONNECT_SRC=
# VITE_CSP_FEDERATION_SRC=
